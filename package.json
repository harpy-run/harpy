{
  "name": "@harpy-run/harpy",
  "version": "2.6.7",
  "description": "Self-hosted control plane for AI coding agents — web and mobile",
  "keywords": [
    "ai",
    "coding-agents",
    "claude-code",
    "codex",
    "gemini-cli",
    "opencode",
    "qwen",
    "grok",
    "devin",
    "self-hosted",
    "developer-tools",
    "terminal",
    "websocket",
    "workbench",
    "llm",
    "preact"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harpy-run/harpy.git"
  },
  "homepage": "https://harpy.run",
  "bugs": {
    "url": "https://github.com/harpy-run/harpy/issues"
  },
  "funding": "https://buymeacoffee.com/alicomert",
  "author": "Ali Comert and Harpy Contributors",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "preferGlobal": true,
  "bin": {
    "harpy": "server/cli.js"
  },
  "files": [
    "dist",
    "server",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "dev": "vite",
    "server": "node server/cli.js start --port 3001",
    "start": "node server/cli.js start --port 3001",
    "build": "vite build",
    "prepack": "npm run build",
    "version:sync": "node scripts/sync-version.mjs",
    "check:version": "node scripts/check-version-sync.mjs",
    "version": "node scripts/sync-version.mjs",
    "preview": "vite preview",
    "lint": "eslint ."
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@vscode-elements/elements": "^2.5.1",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-webgl": "^0.19.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-css": "^6.3.0",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.1",
    "@codemirror/lang-python": "^6.1.6",
    "@codemirror/language": "^6.10.0",
    "@codemirror/merge": "^6.8.0",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.34.0",
    "@eslint/js": "^9.12.0",
    "@fontsource/cascadia-code": "^5.3.0",
    "@preact/signals": "^1.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vscode/codicons": "^0.0.40",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "eslint": "^9.12.0",
    "globals": "^15.11.0",
    "preact": "^10.24.0",
    "tailwindcss": "^4.3.3",
    "vite": "^6.0.0"
  }
