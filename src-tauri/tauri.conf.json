{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Harpy",
  "version": "2.6.3",
  "identifier": "run.harpy.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5199",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && npm run desktop:prepare"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Harpy",
        "width": 1280,
        "height": 800,
        "minWidth": 320,
        "minHeight": 480,
        "visible": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../.desktop-resources/harpy": "harpy-runtime"
    },
    "icon": [
      "../public/icons/icon-128x128.png",
      "../public/icons/icon-512x512.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false
  }
}
